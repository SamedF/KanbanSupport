{
  "name": "outlook-support-kanban-web",
  "version": "1.0.0",
  "private": true,
  "description": "Secure web app wrapper for Outlook Support Kanban",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup:create": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-create.ps1",
    "backup:list": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-list.ps1",
    "release:snapshot": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release-snapshot.ps1",
    "check": "node --check server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "prisma": "^7.8.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "^4.12.25"
  }
}
