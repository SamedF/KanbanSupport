{
  "name": "outlook-support-kanban-web",
  "version": "1.0.0",
  "private": true,
  "description": "Secure web app wrapper for Outlook Support Kanban",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backup:create": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-create.ps1",
    "backup:list": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-list.ps1",
    "release:snapshot": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release-snapshot.ps1",
    "check": "node --check server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prisma": "^7.9.1"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "hono": "^4.12.25"
  }
}
