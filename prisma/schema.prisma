generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  displayName  String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments      TicketComment[]
  events        TicketEvent[]
  apiTokens     ApiToken[]
  oauthAuthCodes OAuthAuthCode[]
}

model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Dynamically registered per RFC 7591 - each Claude connector instance
// (personal or org-wide) self-registers once and gets its own clientId,
// bound to the exact redirectUris it registered with. authorize/token both
// strictly enforce that binding, so a registered client can never be used
// to redirect anywhere except where it originally declared.
model OAuthClient {
  id           Int      @id @default(autoincrement())
  clientId     String   @unique
  clientName   String?
  redirectUris String[]
  createdAt    DateTime @default(now())

  authCodes    OAuthAuthCode[]
}

// Short-lived, single-use authorization code (PKCE, S256 only). Hashed at
// rest like ApiToken/password-reset tokens - the raw code only ever exists
// in the redirect URL and the immediate token-exchange request.
model OAuthAuthCode {
  id                  Int       @id @default(autoincrement())
  codeHash            String    @unique
  clientId            Int
  userId              Int
  redirectUri          String
  codeChallenge        String
  codeChallengeMethod  String
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime  @default(now())

  client               OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Ticket {
  id              Int       @id @default(autoincrement())
  externalId      String?   @unique
  subject         String
  senderName      String?
  senderEmail     String?
  companyName     String?
  status          String    @default("New")
  priority        String    @default("Normal")
  category        String?
  assignedAgent   String?
  csAgent         String?
  source          String    @default("email")
  emailMessageId  String?
  hubspotTicketId String?
  jiraTicketKey   String?
  body            String?
  emailRaw        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
  resolvedTeamsNotifiedAt DateTime?

  comments        TicketComment[]
  events          TicketEvent[]

  @@index([senderEmail])
  @@index([status])
  @@index([assignedAgent])
  @@index([csAgent])
  @@index([createdAt])
}

model TicketComment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  userId     Int?
  comment    String
  isInternal Boolean  @default(true)
  tags       String[] @default([])
  createdAt  DateTime @default(now())

  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TicketEvent {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  userId    Int?
  eventType String
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model OAuthToken {
  id           Int      @id @default(autoincrement())
  provider     String   @unique
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SyncLog {
  id        Int      @id @default(autoincrement())
  provider  String
  syncType   String
  status    String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())
}
